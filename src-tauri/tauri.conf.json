{
  "productName": "SIP Session Analyzer",
  "version": "0.1.0",
  "identifier": "com.example.sip-session-analyzer",
  "build": {
    "beforeDevCommand": "cd ./frontend && npm run dev",
    "beforeBuildCommand": "cd ./frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIP Session Analyzer",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
	"icon": [
		"icons/32x32.png",
		"icons/128x128.png",
		"icons/128x128@2x.png",
		"icons/icon.icns",
		"icons/icon.ico"
	]
  }
}
